# Secret de signature des cookies de session admin (>= 32 caractères).
# Optionnel : s'il est absent, un secret aléatoire est généré et stocké en base.
SESSION_SECRET=
# Jeton exigé sur /setup pour définir le premier mot de passe admin (recommandé).
SETUP_TOKEN=
# Mettre à false uniquement si l'app est servie en HTTP simple (sans HTTPS).
COOKIE_SECURE=true
